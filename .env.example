# Pulse Environment Configuration
PULSE_ENV=development

# PostgreSQL Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=pulse_user
POSTGRES_PASSWORD=pulse_password
POSTGRES_DB=pulse

# Database Connection URLs
# Async URL for FastAPI & async workers (asyncpg)
DATABASE_URL=postgresql+asyncpg://pulse_user:pulse_password@postgres:5432/pulse
# Sync URL for Alembic migrations (psycopg2)
SYNC_DATABASE_URL=postgresql+psycopg2://pulse_user:pulse_password@postgres:5432/pulse

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Worker Pool Configuration
WORKER_CONCURRENCY=8

# Retry & Backoff Configuration
RETRY_BASE_DELAY=1.0
RETRY_MAX_ATTEMPTS=3
RETRY_JITTER_MAX=0.5

# Recovery & Reaper Configuration
HEARTBEAT_INTERVAL_SECONDS=3.0
HEARTBEAT_TTL_SECONDS=10.0
REAPER_INTERVAL_SECONDS=5.0
STALE_JOB_TIMEOUT_SECONDS=30.0
